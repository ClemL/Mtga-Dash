<?xml version="1.0" encoding="utf-8"?>
<!-- Restores use nuget.org only: the owner's global config includes a private feed that answers 401. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
